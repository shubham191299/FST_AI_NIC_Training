   "source": [
    "import ollama\n",
    "\n",
    "stream = ollama.chat(\n",
    "    model=\"llama3.2:3b\",\n",
    "    messages=[{\"role\": \"user\", \"content\": \"Say hello in one line.\"}],\n",
    "    stream=True,\n",
    ")\n",
    "for chunk in stream:\n",
    "    print(chunk[\"message\"][\"content\"], end=\"\", flush=True)"
   ]
  },
